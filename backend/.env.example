YT_API_KEY=your-youtube-data-api-key
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string
GENRE_TZ=Asia/Manila
DATABASE_URL=sqlite:///./radio.db
FRONTEND_ORIGIN=http://localhost:5173
CACHE_TTL_MINUTES=60
TRACK_GAP_SECONDS=2
PRELOAD_LEAD_SECONDS=20
LOUDNESS_TARGET_DB=-15
LOUDNESS_MAX_BOOST_DB=6
# Set false to skip the background loudness lookups entirely
LOUDNESS_LOOKUP_ENABLED=true
# Set COOKIE_SECURE=false when developing over plain http://localhost
COOKIE_SECURE=true
