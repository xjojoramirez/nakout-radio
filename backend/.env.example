YT_API_KEY=your-youtube-data-api-key
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string
GENRE_TZ=Asia/Manila
DATABASE_URL=sqlite:///./radio.db
FRONTEND_ORIGIN=http://localhost:5173
CACHE_TTL_MINUTES=60
TRACK_GAP_SECONDS=2
PRELOAD_LEAD_SECONDS=20
# Anchor near the loudest masters so full fader stays as loud as raw YouTube.
LOUDNESS_TARGET_DB=-9
LOUDNESS_MAX_BOOST_DB=6
# Set false to skip the background loudness lookups entirely
LOUDNESS_LOOKUP_ENABLED=true
# Set false to skip automatic track-detail enrichment (Deezer + MusicBrainz)
ENRICHMENT_ENABLED=true
# Pause between track lookups; MusicBrainz gets at least 1.05s
ENRICHMENT_PAUSE_SECONDS=0.5
# Abort a run after this many consecutive provider failures
ENRICHMENT_MAX_CONSECUTIVE_ERRORS=5
# Set COOKIE_SECURE=false when developing over plain http://localhost
COOKIE_SECURE=true
# Automatic genre runs target this percentage of repeats from the previous airing
ROTATION_REPEAT_PERCENT=10
# Blocks shorter than this many songs do not force a repeat
ROTATION_MIN_WINDOW=5
# Assumed block size when the schedule has no upcoming genre change
ROTATION_FALLBACK_WINDOW=20
